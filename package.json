{
  "name": "alafazam.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://alafazam.com",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/check-links.mjs",
    "build:preview": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "pnpm build && gh-pages -d dist",
    "deploy:preview": "DEPLOY_BASE=/preview/ VITE_SHOW_DRAFTS=1 pnpm build:preview && gh-pages -d dist --dest preview --add -m \"Deploy preview\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/react-helmet": "^6.1.11",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-router": "^7.18.4",
    "react-router-dom": "^7.18.4",
    "react-simple-typewriter": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gh-pages": "^6.3.0",
    "markdown-it": "^14.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "postcss-selector-parser@<7.1.6": "^7.1.6"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
